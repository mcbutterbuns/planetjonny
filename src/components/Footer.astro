---
const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-white/10 bg-slate-950/80 backdrop-blur-md text-slate-400 py-12 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-8 border-b border-white/5">
      
      <!-- Brand & Mission -->
      <div>
        <h3 class="text-white font-bold text-lg tracking-wider mb-3">PLANET<span class="text-cyan-400">JONNY</span></h3>
        <p class="text-slate-400 text-xs leading-relaxed max-w-sm">
          Deep-sky and planetary astrophotography from Oregon dark sky sites. Capturing nebulae, galaxies, and celestial wonders through long-exposure astrophotography.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-widest mb-3">Navigation</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-cyan-400 transition-colors">Target Gallery</a></li>
          <li><a href="/blog" class="hover:text-cyan-400 transition-colors">Blog & Field Notes</a></li>
          <li><a href="/equipment" class="hover:text-cyan-400 transition-colors">Telescopes & Equipment</a></li>
          <li><a href="/about" class="hover:text-cyan-400 transition-colors">About</a></li>
          <li><a href="https://instagram.com/oregon_astro" target="_blank" rel="noopener noreferrer" class="text-pink-400 hover:text-pink-300 transition-colors">📷 Instagram @oregon_astro</a></li>
        </ul>
      </div>

      <!-- Tech Stack / Image Specs -->
      <div>
        <h4 class="text-white font-semibold text-xs uppercase tracking-widest mb-3">Processing Pipeline</h4>
        <div class="flex flex-wrap gap-2 text-[11px] font-mono">
          <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-cyan-300">PixInsight</span>
          <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-purple-300">ZWO ASIAIR Plus</span>
        </div>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
      <p>© {currentYear} PlanetJonny Astrophotography. All rights reserved.</p>
      <p class="mt-2 sm:mt-0">Powered by <span class="text-slate-300">Astro & Tailwind CSS</span></p>
    </div>
  </div>
</footer>

---
import { Image } from 'astro:assets';

interface Props {
  photo: {
    id: string;
    data: {
      title: string;
      catalogId: string;
      category: string;
      coverImage: any;
      captureDate: string;
      constellation: string;
      acquisition: {
        totalIntegration: string;
      };
    };
  };
}

const { photo } = Astro.props;
const { title, catalogId, category, coverImage, acquisition } = photo.data;
---

<a 
  href={`/photos/${photo.id}`}
  class="group relative block rounded-2xl overflow-hidden glass-panel glass-panel-hover"
>
  <!-- Image Container -->
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-slate-900">
    <Image 
      src={coverImage} 
      alt={title}
      width={800}
      height={600}
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
    />
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-300"></div>

    <!-- Category Pill -->
    <div class="absolute top-4 left-4 flex items-center space-x-2">
      <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-slate-950/80 backdrop-blur-md text-cyan-300 border border-cyan-500/30 shadow-lg">
        {category}
      </span>
    </div>

    <!-- Integration Badge -->
    <div class="absolute top-4 right-4 px-2.5 py-1 rounded-full text-[11px] font-mono bg-slate-950/80 backdrop-blur-md text-slate-300 border border-white/10">
      ⏱️ {acquisition.totalIntegration}
    </div>
  </div>

  <!-- Content Footer -->
  <div class="p-5">
    <div class="flex items-center justify-between text-xs font-mono text-cyan-400 mb-1">
      <span>{catalogId}</span>
    </div>
    <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">
      {title}
    </h3>
    <div class="mt-3 pt-3 border-t border-white/5 flex items-center justify-between text-xs text-slate-400">
      <span>View Capture Specs</span>
      <span class="text-cyan-400 group-hover:translate-x-1 transition-transform">→</span>
    </div>
  </div>
</a>

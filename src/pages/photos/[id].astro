---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const photos = await getCollection('photos');
  return photos.map((photo) => ({
    params: { id: photo.id },
    props: { photo },
  }));
}

const { photo } = Astro.props;
const { title, catalogId, category, coverImage, captureDate, location, bortleClass, constellation, equipment, acquisition } = photo.data;
const { Content } = await render(photo);
---

<Layout title={`${title} (${catalogId}) - PlanetJonny Astrophotography`} description={`Acquisition details and high-resolution astrophotography capture for ${title}. Integrated for ${acquisition.totalIntegration} from Bortle ${bortleClass} skies.`}>
  
  <article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Back to Gallery Link -->
    <div class="mb-6">
      <a href="/" class="inline-flex items-center space-x-2 text-xs font-mono text-cyan-400 hover:text-cyan-300 transition-colors">
        <span>← Back to Target Gallery</span>
      </a>
    </div>

    <!-- Header Specs -->
    <header class="mb-8">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
          {category}
        </span>
        <span class="px-3 py-1 rounded-full text-xs font-mono bg-slate-900 border border-slate-800 text-slate-300">
          {constellation} Constellation
        </span>
        <span class="px-3 py-1 rounded-full text-xs font-mono bg-slate-900 border border-slate-800 text-slate-300">
          Bortle {bortleClass} Site
        </span>
      </div>

      <div class="text-xs font-mono text-cyan-400 mb-1">{catalogId}</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">{title}</h1>
    </header>

    <!-- Main High-Res Showcase Image -->
    <div class="relative rounded-3xl overflow-hidden glass-panel border border-white/10 shadow-2xl mb-12 bg-slate-950">
      <Image 
        src={coverImage} 
        alt={title}
        width={1600}
        height={1200}
        class="w-full h-auto max-h-[75vh] object-contain mx-auto"
      />
      <div class="p-4 bg-slate-950/80 border-t border-white/10 flex flex-wrap items-center justify-between text-xs text-slate-400 font-mono">
        <span>📍 {location}</span>
        <span>📅 Captured: {captureDate}</span>
        <span>⏱️ Total Exposure: {acquisition.totalIntegration}</span>
      </div>
    </div>

    <!-- Specs & Details Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Technical Specifications Sidebar -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Equipment Card -->
        <div class="p-6 rounded-2xl glass-panel border border-white/10 space-y-4">
          <h3 class="text-base font-bold text-white flex items-center space-x-2 border-b border-white/10 pb-3">
            <span class="text-cyan-400">🔭</span>
            <span>Imaging Equipment</span>
          </h3>

          <div class="space-y-3 text-xs">
            <div>
              <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Telescope / Optics</span>
              <span class="text-white font-medium">{equipment.telescope}</span>
            </div>
            <div>
              <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Camera</span>
              <span class="text-white font-medium">{equipment.camera}</span>
            </div>
            <div>
              <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Equatorial Mount</span>
              <span class="text-white font-medium">{equipment.mount}</span>
            </div>
            <div>
              <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Filters</span>
              <span class="text-white font-medium">{equipment.filters}</span>
            </div>
            {equipment.guiding && (
              <div>
                <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Guiding Setup</span>
                <span class="text-white font-medium">{equipment.guiding}</span>
              </div>
            )}
          </div>
        </div>

        <!-- Acquisition Card -->
        <div class="p-6 rounded-2xl glass-panel border border-white/10 space-y-4">
          <h3 class="text-base font-bold text-white flex items-center space-x-2 border-b border-white/10 pb-3">
            <span class="text-cyan-400">📊</span>
            <span>Acquisition & Subframes</span>
          </h3>

          <div class="space-y-4 text-xs">
            
            <!-- Light Frames (Supports String OR Multi-Filter Array) -->
            <div>
              <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px] mb-1.5">Light Frames Breakdown</span>
              {typeof acquisition.lightFrames === 'string' ? (
                <span class="text-white font-medium font-mono">{acquisition.lightFrames}</span>
              ) : (
                <div class="space-y-2">
                  {acquisition.lightFrames.map((item) => (
                    <div class="p-2.5 rounded-xl bg-slate-950/80 border border-white/5 flex items-center justify-between font-mono">
                      <div>
                        <span class="text-cyan-300 font-semibold block text-[11px]">{item.filter}</span>
                        <span class="text-slate-400 text-[10px]">{item.subframes}</span>
                      </div>
                      {item.duration && (
                        <span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-[10px]">
                          {item.duration}
                        </span>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div>
              <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Total Integration</span>
              <span class="text-cyan-300 font-bold font-mono text-sm">{acquisition.totalIntegration}</span>
            </div>

            {acquisition.exposurePerFrame && (
              <div>
                <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Exposure per Sub</span>
                <span class="text-white font-medium">{acquisition.exposurePerFrame}</span>
              </div>
            )}
            
            {acquisition.gainIso && (
              <div>
                <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Gain / ISO Offset</span>
                <span class="text-white font-medium font-mono">{acquisition.gainIso}</span>
              </div>
            )}

            {acquisition.calibration && (
              <div>
                <span class="block text-slate-400 uppercase tracking-wider font-mono text-[10px]">Calibration Frames</span>
                <span class="text-white font-medium">{acquisition.calibration}</span>
              </div>
            )}

          </div>
        </div>

      </div>

      <!-- Markdown Description -->
      <div class="lg:col-span-7 space-y-8">
        
        <!-- Target Notes Body -->
        <div class="p-8 rounded-2xl glass-panel border border-white/10 prose prose-invert max-w-none text-slate-300 leading-relaxed">
          <Content />
        </div>

      </div>

    </div>

  </article>

</Layout>

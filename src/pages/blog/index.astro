---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<Layout title="Field Logs & Articles - PlanetJonny Astrophotography" description="Astrophotography trip reports, observing logs, PixInsight processing tutorials, and equipment deep dives.">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    
    <!-- Blog Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono mb-4">
        <span>📖 Field Notes & Tutorials</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Observing <span class="text-gradient">Logs & Journal</span>
      </h1>
      <p class="text-slate-300 text-sm leading-relaxed">
        Deep-sky field reports from Oregon dark sky reserves, PixInsight image processing tutorials, and telescope equipment guides.
      </p>
    </div>

    <!-- Blog Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {sortedPosts.map((post) => (
        <a 
          href={`/blog/${post.id}`}
          class="group rounded-3xl overflow-hidden glass-panel glass-panel-hover flex flex-col justify-between"
        >
          <div>
            <!-- Cover Image Preview -->
            {post.data.coverImage && (
              <div class="relative aspect-[16/9] w-full overflow-hidden bg-slate-900">
                <Image 
                  src={post.data.coverImage} 
                  alt={post.data.title}
                  width={800}
                  height={450}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
              </div>
            )}

            <div class="p-8">
              <!-- Meta Tags -->
              <div class="flex flex-wrap items-center gap-2 mb-3 text-xs font-mono">
                <span class="text-cyan-400">📅 {post.data.pubDate}</span>
                <span class="text-slate-500">•</span>
                <span class="text-slate-300">⏱️ {post.data.readTime}</span>
              </div>

              <h2 class="text-2xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-3 leading-snug">
                {post.data.title}
              </h2>
              
              <p class="text-xs text-slate-300 leading-relaxed mb-6">
                {post.data.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono bg-slate-900 border border-slate-800 text-slate-300">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="px-8 pb-8 pt-2 flex items-center justify-between text-xs text-cyan-400 font-mono">
            <span>Read Article</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

  </div>

</Layout>

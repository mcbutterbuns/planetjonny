---
import Layout from '../layouts/Layout.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const photos = await getCollection('photos');
const blogPosts = await getCollection('blog');

// Sort featured first, then by date descending
const sortedPhotos = photos.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return new Date(b.data.captureDate).getTime() - new Date(a.data.captureDate).getTime();
});

const featuredPhoto = photos[0];
const recentBlogPosts = blogPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()).slice(0, 2);
---

<Layout title="PlanetJonny - Deep-Sky Astrophotography Portfolio">
  
  <!-- Hero Showcase Section -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
    
    <!-- Background Glow Blobs -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-cyan-500/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/3 left-1/3 w-[400px] h-[400px] bg-purple-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-16">
        

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-6 leading-tight">
          Capturing the <span class="text-gradient">Deep Cosmos</span>
        </h1>
        
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-light">
          Deep-sky nebulae, ancient galaxies, and planetary portraits captured from Pacific Northwest dark sky reserves. Complete with telescope specifications, exposure logs, and processing pipelines.
        </p>


      </div>

      <!-- Featured Target Banner -->
      {featuredPhoto && (
        <div class="relative rounded-3xl overflow-hidden glass-panel border border-cyan-500/20 shadow-2xl shadow-cyan-500/10 mb-20 group">
          <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
            
            <!-- Featured Image -->
            <div class="lg:col-span-7 relative aspect-[16/10] lg:aspect-auto lg:h-[440px] overflow-hidden bg-slate-950">
              <Image 
                src={featuredPhoto.data.coverImage} 
                alt={featuredPhoto.data.title}
                width={1200}
                height={800}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-slate-950/90 via-slate-950/40 to-transparent"></div>
            </div>

            <!-- Featured Details -->
            <div class="lg:col-span-5 p-8 lg:p-10">
              <span class="block text-xs font-mono text-cyan-400 mb-1">{featuredPhoto.data.catalogId}</span>
              <h2 class="text-3xl font-bold text-white mb-4">{featuredPhoto.data.title}</h2>
              <p class="text-sm text-slate-300 leading-relaxed mb-6 line-clamp-3">
                {featuredPhoto.body ? featuredPhoto.body.slice(0, 180) + '...' : 'Deep-sky astrophotography capture with high integration signal-to-noise ratio.'}
              </p>

              <!-- Quick Specs Chips -->
              <div class="flex flex-wrap gap-2 text-xs font-mono text-slate-300 mb-8">
                <span class="px-3 py-1 rounded-lg bg-slate-900/80 border border-slate-800">⏱️ {featuredPhoto.data.acquisition.totalIntegration}</span>
                <span class="px-3 py-1 rounded-lg bg-slate-900/80 border border-slate-800">✨ {featuredPhoto.data.constellation}</span>
              </div>

              <a 
                href={`/photos/${featuredPhoto.id}`}
                class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-medium shadow-lg shadow-cyan-500/25 hover:from-cyan-400 hover:to-blue-500 transition-all duration-200 text-sm"
              >
                Explore Acquisition Details →
              </a>
            </div>

          </div>
        </div>
      )}

      <!-- Section Title & Filter Tabs -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10 pb-4 border-b border-white/10">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-wide">Target Gallery</h2>
          <p class="text-xs text-slate-400 mt-1">Select any target for full telescope and camera technical specifications.</p>
        </div>
        
        <!-- Category Filter Tabs -->
        <div class="flex items-center space-x-2 overflow-x-auto pb-2 sm:pb-0">
          <button class="px-4 py-2 rounded-xl text-xs font-medium bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">All Targets</button>
          <button class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-white/5 transition-colors">Deep Sky</button>
          <button class="px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white hover:bg-white/5 transition-colors">Planetary</button>
        </div>
      </div>

      <!-- Photo Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
        {sortedPhotos.map((photo) => (
          <PhotoCard photo={photo} />
        ))}
      </div>

      <!-- Recent Field Logs & Articles Teaser -->
      {recentBlogPosts.length > 0 && (
        <section class="pt-12 border-t border-white/10">
          <div class="flex items-center justify-between mb-8">
            <div>
              <h2 class="text-2xl font-bold text-white">Latest Field Logs & Tutorials</h2>
              <p class="text-xs text-slate-400 mt-1">Observing trip reports and PixInsight processing guides.</p>
            </div>
            <a href="/blog" class="text-xs font-mono text-cyan-400 hover:text-cyan-300 transition-colors flex items-center space-x-1">
              <span>View All Articles</span>
              <span>→</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {recentBlogPosts.map((post) => (
              <a 
                href={`/blog/${post.id}`}
                class="p-6 rounded-2xl glass-panel glass-panel-hover flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center space-x-2 text-[11px] font-mono text-cyan-400 mb-2">
                    <span>📅 {post.data.pubDate}</span>
                    <span>•</span>
                    <span>⏱️ {post.data.readTime}</span>
                  </div>
                  <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors mb-2">
                    {post.data.title}
                  </h3>
                  <p class="text-xs text-slate-400 leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-white/5 text-xs text-cyan-400 flex items-center justify-between font-mono">
                  <span>Read Article</span>
                  <span>→</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </section>

</Layout>
